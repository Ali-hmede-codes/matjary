{
  "name": "matjary-backend",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API and isolated media worker for the Matjary showcase platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:worker && npm run build:migrations",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "build:migrations": "nest build migrations",
    "dev:api": "nest start api --watch",
    "dev:worker": "nest start worker --watch",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"{apps,libs,test,scripts}/**/*.{ts,json,cjs}\" \"*.json\" \"infra/**/*.yaml\"",
    "format:check": "prettier --check \"{apps,libs,test,scripts}/**/*.{ts,json,cjs}\" \"*.json\" \"infra/**/*.yaml\"",
    "test": "node -r ./test/setup-unit.cjs -r ts-node/register -r tsconfig-paths/register --test test/unit/environment.test.ts test/unit/database.test.ts test/unit/health.test.ts test/unit/auth.test.ts test/unit/authorization.test.ts test/unit/subscription-trial.test.ts test/unit/showcases.test.ts test/unit/engagement.test.ts test/unit/media.test.ts test/unit/admin.test.ts test/unit/boost.test.ts test/unit/monitoring.test.ts test/unit/website-settings.test.ts test/unit/user-dashboard.test.ts test/unit/seo-share.test.ts test/unit/business-categories.test.ts test/unit/feed-ranking.test.ts test/unit/product-options.test.ts test/unit/store-design.test.ts test/unit/store-directory.test.ts test/unit/store-favorites.test.ts test/unit/stories.test.ts test/unit/team.test.ts",
    "test:integration": "node -r ts-node/register -r tsconfig-paths/register --test test/integration/database.test.ts",
    "env:init": "node scripts/init-env.cjs",
    "monitoring:init": "node scripts/init-monitoring.cjs",
    "monitoring:validate": "node scripts/validate-monitoring.cjs",
    "load:check": "node scripts/load-check.cjs",
    "test:admin:browser": "node -r ./test/setup-unit.cjs -r ts-node/register -r tsconfig-paths/register test/browser/admin.fixture.ts",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d libs/database/src/data-source.ts",
    "db:migration:show": "typeorm-ts-node-commonjs migration:show -d libs/database/src/data-source.ts",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate -d libs/database/src/data-source.ts",
    "db:migration:revert": "typeorm-ts-node-commonjs migration:revert -d libs/database/src/data-source.ts",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml --profile tools up -d --wait --wait-timeout 180",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml --profile tools down",
    "stack:up": "docker compose --env-file .env -f infra/compose.yaml --profile app up -d --build --wait --wait-timeout 180"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.0",
    "bullmq": "^5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie": "^1.1.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.12.0",
    "prettier": "^3.5.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
