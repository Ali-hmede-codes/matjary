# Run npm run env:init from backend/ to create a private .env with local passwords.
# Then: npm run infra:up; npm run db:migrate; npm run dev:api
# MySQL and Redis are required. Local media works without any cloud account.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Exact browser origin; also register it in Google's Authorized JavaScript origins.
# Use HTTPS in production. The login page is /api/v1/auth/login.
APP_ORIGIN=http://localhost:3000
# Public web client ID only. No Google client secret is used by this flow.
GOOGLE_CLIENT_ID=
# Absolute session lifetime (7 days); logout revokes the Redis session immediately.
AUTH_SESSION_TTL_SECONDS=604800
# The free plan is a one-time trial of this many days. When it ends, the owner
# keeps read-only access and published content until a paid plan is assigned.
# The rollout migration grants existing accounts a fixed 7-day window.
FREE_TRIAL_DAYS=7
# Protected bootstrap admins (comma-separated emails); keep your own email here.
# Additional admins can be assigned in Admin > Users > Change role.
ADMIN_EMAILS=
# Built-in admin workspace: /api/v1/admin. Accounts are created by real Google login.
# Google Auth Platform: Web application client; authorize the exact APP_ORIGIN.
# Set your verified Google account email in ADMIN_EMAILS; never put a password here.

# Error issues are sanitized, capped at 10,000 groups, and pruned in bounded batches.
ERROR_RETENTION_DAYS=30
# Optional private Prometheus origin. Empty means VPS charts are not configured.
# The monitoring Compose overlay sets this to http://prometheus:9090 inside the API.
PROMETHEUS_URL=
# Private file containing the random metrics bearer token, never the token itself.
# Empty disables the scrape endpoint. Compose mounts /run/secrets/metrics_token.
METRICS_TOKEN_FILE=
# Linux monitoring overlay only: an existing private docker0/br-* gateway IP.
# A validation service rejects public interfaces; node_exporter binds only here.
MONITORING_HOST_ADDRESS=
# Absolute host path generated by npm run monitoring:init (Linux, UID 1000/root).
METRICS_TOKEN_HOST_FILE=
# Exact trusted reverse-proxy IPs/CIDRs, comma-separated. Never use true/*.
# Container requests arrive from the proxy's container/bridge IP, not 127.0.0.1.
TRUST_PROXY_CIDRS=

# MySQL 8.4 LTS. phpMyAdmin is its administration UI, not the database engine.
# Fill both password fields with different strong local passwords.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=matjary
MYSQL_USER=matjary
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Per-process pool; budget connections across the API and worker.
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT_MS=5000
PHPMYADMIN_PORT=8081

# Redis / BullMQ. Start media processing with one job at a time.
# Fill the password before starting local infrastructure.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
MEDIA_WORKER_CONCURRENCY=1

# Local disk is the current development AND deployment mode.
# Moving to S3 later requires copying/verifying objects and configuring delivery.
STORAGE_PROVIDER=local
# Relative to backend/ on the host; Compose overrides to /var/lib/matjary/media
# on the same persistent volume in the API and worker (matching node UID).
STORAGE_LOCAL_DIR=storage
# Optional HTTP(S) origin; empty derives APP_ORIGIN. Local byte routes are
# /api/v1/uploads/:key. Upload and private download URLs require owner cookies.
STORAGE_PUBLIC_BASE_URL=

# S3-compatible storage. Used when STORAGE_PROVIDER=s3. Use private originals
# and publish processed assets only. Obtain endpoint and region from the
# selected storage provider. These values may stay empty in local mode.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional S3 delivery base for published variants only. Leave empty locally.
# Keep the bucket private; never expose draft variants through public bucket ACLs.
MEDIA_PUBLIC_BASE_URL=

# Engagement (like/view) counters are buffered in Redis and flushed to MySQL
# asynchronously, so a click never writes synchronously to the database.
ENGAGEMENT_RATE_LIMIT_PER_MIN=30
ENGAGEMENT_VIEW_DEDUPE_TTL_SECONDS=300
ENGAGEMENT_FLUSH_INTERVAL_SECONDS=60
# Legacy compatibility setting; pending batches/live state never expire.
ENGAGEMENT_REDIS_KEY_TTL_SECONDS=86400
# Redis AOF everysec + noeviction is configured in Compose. Complete Redis loss
# may lose unflushed events; MySQL batch receipts prevent replay double-counting.

# Nominatim (OpenStreetMap) - Free geocoding service for store locations
# No API key required. Customize User-Agent for production.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Matjary/1.0 (contact@matjary.com)

# Global hard ceilings; plans may impose stricter limits, never raise these.
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_VIDEO_SIZE_BYTES=209715200
MEDIA_MAX_VIDEO_DURATION_SECONDS=90
MEDIA_MAX_VIDEO_HEIGHT=1080
MEDIA_MAX_IMAGE_PIXELS=40000000
# How long a browser or a shared proxy may reuse a published media variant.
# Variant keys are immutable (they embed the asset UUID), so caching them is
# what lets one VPS serve many visitors. Unpublishing hides new requests at
# once but a cached copy can survive this window; 0 revalidates every request.
MEDIA_PUBLIC_CACHE_SECONDS=3600
# Images: AVIF55/WebP80/JPEG84 at 480/1080/1600 (no upscaling).
# Video: bounded H.264 720p MP4 (CRF 20, 4 Mbit/s ceiling) + JPEG poster.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TEMP_DIR=.tmp/media
MEDIA_JOB_TIMEOUT_MS=300000
MEDIA_UPLOAD_TIMEOUT_MS=300000
# Successful originals are removed after readiness commit. Failed/expired
# uploads are retried for cleanup after this retention, excluding active jobs.
MEDIA_ORIGINAL_RETENTION_HOURS=24
WORKER_HEARTBEAT_FILE=.tmp/worker-heartbeat

# Social link previews. The API prerenders one HTML shell per shop, section,
# and product into the published /stores directory, so crawlers read real
# titles and images without any host-level crawler rule. Compose mounts that
# directory read-write here; setup copies the built index.html next to it as
# the template so permissions never depend on the rest of the web root.
SHARE_SHELL_TEMPLATE=/srv/share/.matjary-template.html
SHARE_SHELL_ROOT=/srv/share
# How often changed content is re-rendered (30-3600 seconds).
SHARE_SHELL_REFRESH_SECONDS=120
# Random secret used by the deployment hook that refreshes shells right after
# the frontend is published. setup-vps.sh generates it; empty disables the hook.
SHARE_SHELL_TOKEN=
