# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the Matjary API.
# Builder stage installs all deps (incl. dev) and runs the NestJS webpack build.
# Runtime stage keeps only the built output + production node_modules.

FROM node:22-slim AS builder

WORKDIR /app

# System deps needed to build native modules (e.g. sharp) during npm ci.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies (includes dev deps needed for the build).
COPY package.json package-lock.json ./
RUN npm ci

# Copy source and build the API bundle.
COPY . .
RUN npm run build:api

# ---------------------------------------------------------------------------
# Runtime stage
# ---------------------------------------------------------------------------
FROM node:22-slim

WORKDIR /app

# libvips is a hard runtime dependency of sharp (image processing).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips \
    && rm -rf /var/lib/apt/lists/*

# Copy only the built output and production dependencies from the builder.
COPY --from=builder /app/dist/apps/api ./dist/apps/api
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

ENV NODE_ENV=production

# The API listens on the port configured by API_PORT (default 3000).
EXPOSE 3000

CMD ["node", "dist/apps/api/main.js"]
