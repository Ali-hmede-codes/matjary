# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the Matjary media worker.
# The worker has no HTTP listener; it consumes BullMQ jobs from Redis and
# encodes media (sharp for images, FFmpeg for video) in an isolated process.

FROM node:22-slim AS builder

WORKDIR /app

# System deps needed to build native modules (e.g. sharp) during npm ci.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies (includes dev deps needed for the build).
COPY package.json package-lock.json ./
RUN npm ci

# Copy source and build the worker bundle.
COPY . .
RUN npm run build:worker

# ---------------------------------------------------------------------------
# Runtime stage
# ---------------------------------------------------------------------------
FROM node:22-slim

WORKDIR /app

# libvips is a hard runtime dependency of sharp.
# ffmpeg/ffprobe are required for video transcoding and probing.
# Both come from the system image, not from npm (per infrastructure doc).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy only the built output and production dependencies from the builder.
COPY --from=builder /app/dist/apps/worker ./dist/apps/worker
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

ENV NODE_ENV=production

# The worker runs queue consumers only; no HTTP port is exposed.
CMD ["node", "dist/apps/worker/main.js"]
