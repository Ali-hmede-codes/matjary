# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the Matjary media worker.
# The worker has no HTTP listener; it consumes BullMQ jobs from Redis and
# encodes media (sharp for images, FFmpeg for video) in an isolated process.

FROM node:22-slim AS builder

WORKDIR /app

# Install dependencies (includes dev deps needed for the build).
COPY package.json package-lock.json ./
RUN npm ci

# Copy source and build the worker bundle.
COPY . .
RUN npm run build:worker && npm prune --omit=dev

# ---------------------------------------------------------------------------
# Runtime stage
# ---------------------------------------------------------------------------
FROM node:22-slim

WORKDIR /app

# Sharp supplies its matching libvips through npm platform packages.
# Only the worker needs the system FFmpeg/ffprobe executables. The fonts let
# the generated shop name cards render Latin and Arabic names; without them an
# SVG text card would be a plain color panel.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg fonts-dejavu-core fonts-kacst \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /var/lib/matjary/media /app/.tmp/media && chown -R node:node /var/lib/matjary /app

# Copy only the built output and production dependencies from the builder.
COPY --from=builder /app/dist/apps/worker ./dist/apps/worker
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

ENV NODE_ENV=production
USER node

# The worker runs queue consumers only; no HTTP port is exposed.
CMD ["node", "dist/apps/worker/main.js"]
