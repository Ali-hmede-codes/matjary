# Development proxy target and existing backend sign-in page origin.
# Match the backend APP_ORIGIN hostname for Google sign-in (no Origin rewriting).
BACKEND_ORIGIN=http://localhost:3000

# Production: serve dist/ and reverse-proxy /api to NestJS on the SAME origin.
# Preserve encoded upload keys, cookies, and range headers. Never expose media
# as a static directory. Do not put passwords or API secrets in VITE_* variables.
